# Required
PORT=4343

# Persistence — same Postgres you use for the other products.
# Leave unset to run in memory-only demo mode.
DATABASE_URL=

# Admin bearer token — protects GET /api/briefs (mobile inbox + dashboard).
ADMIN_TOKEN=pick-a-long-random-string

# Where this API is publicly reachable (used to render mcpUrl in /api/tools)
PUBLIC_URL=https://hireme-mcp-backend.onrender.com

# Optional: email notifications for new briefs (Gmail app password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Reserved for future embedding-based project search
GOOGLE_API_KEY=
